# ─── NextAuth ───────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=REPLACE_WITH_GENERATED_SECRET
NEXTAUTH_URL=http://localhost:3000

# ─── Google Sheets ──────────────────────────────────────────────────
# Encode JSON key: base64 -i service-account.json | tr -d '\n'
GOOGLE_SERVICE_ACCOUNT_B64=REPLACE_WITH_BASE64_ENCODED_JSON
GOOGLE_SPREADSHEET_ID=REPLACE_WITH_YOUR_SPREADSHEET_ID
